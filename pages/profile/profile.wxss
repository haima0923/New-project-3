.profile-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.profile-card {
  background:
    radial-gradient(circle at 85% 8%, rgba(164, 211, 255, 0.54) 0%, rgba(164, 211, 255, 0) 30%),
    linear-gradient(135deg, #4A9CFF 0%, #1677FF 72%, #0B5ED7 100%);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 30rpx rgba(22, 119, 255, 0.20);
  color: #FFFFFF;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.profile-subtitle {
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  opacity: 0.9;
}

.profile-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 20rpx;
}

.profile-stat {
  background: #F6F8FC;
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  text-align: center;
}

.profile-number {
  color: #1677FF;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
}

.profile-label {
  color: #6B7280;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.status-line {
  align-items: center;
  border-top: 1rpx solid #E5E7EB;
  color: #1F2937;
  display: flex;
  font-size: 28rpx;
  justify-content: space-between;
  padding: 22rpx 0;
}

.status-line:first-of-type {
  border-top: 0;
}

.status-pill {
  background: #EAF2FF;
  border-radius: 999rpx;
  color: #1677FF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 16rpx;
}

.status-muted {
  background: #F3F4F6;
  color: #6B7280;
}

.status-note {
  margin-top: 6rpx;
}

.catalog-card .row-between {
  align-items: flex-start;
  gap: 16rpx;
}

.catalog-intro {
  line-height: 1.5;
  margin-top: 6rpx;
}

.catalog-add-button {
  background: #EAF2FF;
  border: 0;
  border-radius: 999rpx;
  color: #1677FF;
  flex: 0 0 auto;
  font-size: 24rpx;
  line-height: 1;
  margin: 0;
  min-height: 58rpx;
  padding: 16rpx 22rpx;
}

.catalog-editor {
  background: #F8FAFC;
  border: 1rpx solid #DDE3EA;
  border-radius: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.catalog-textarea {
  box-sizing: border-box;
  min-height: 130rpx;
  width: 100%;
}

.catalog-editor-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.catalog-editor-actions {
  margin-top: 4rpx;
}

.catalog-empty {
  background: #F8FAFC;
  border-radius: 14rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 18rpx;
  padding: 18rpx;
}

.catalog-item {
  border-top: 1rpx solid #EAECF0;
  margin-top: 18rpx;
  padding-top: 18rpx;
}

.catalog-item-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.catalog-item-name {
  color: #1D2939;
  font-size: 29rpx;
  font-weight: 800;
}

.catalog-item-actions {
  color: #1677FF;
  display: flex;
  font-size: 24rpx;
  gap: 20rpx;
}

.catalog-delete {
  color: #D92D20;
}

.catalog-item-line {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 7rpx;
  overflow-wrap: anywhere;
}
