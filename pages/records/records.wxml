<view class="page records-page" bindtouchstart="touchStart" bindtouchend="touchEnd">
  <view class="page-title">记录</view>
  <view class="page-subtitle">报价、订单、收款、提醒都在这里，想细看就点进去。</view>

  <scroll-view scroll-x="true" class="record-filter-scroll">
    <view class="record-filter-row">
      <view
        wx:for="{{filterOptions}}"
        wx:key="type"
        class="record-filter {{selectedType === item.type ? 'record-filter-active' : ''}}"
        data-type="{{item.type}}"
        bindtap="changeFilter"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{!records.length}}" class="empty records-empty">
    <view class="card-title">还没有记录</view>
    <view class="muted">先说一句、打一段，或者粘贴聊天记第一笔。</view>
    <button class="primary-button empty-button" bindtap="goInput">去记一笔</button>
  </view>

  <view wx:for="{{records}}" wx:key="id" class="card record-card record-card-{{item.type}}" data-type="{{item.type}}" bindtap="openRecord">
    <view class="row-between">
      <view class="record-type record-type-{{item.type}}">
        <view class="record-type-icon">{{item.typeIcon}}</view>
        <view>{{item.typeLabel}}</view>
      </view>
      <view class="record-time">{{item.time}}</view>
    </view>
    <view class="record-title">{{item.title}}</view>
    <view class="record-summary">{{item.summary}}</view>
  </view>
</view>
