.records-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.record-filter-scroll {
  margin: 0 -32rpx 24rpx;
  white-space: nowrap;
  width: auto;
}

.record-filter-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 32rpx;
}

.record-filter {
  background: #FFFFFF;
  border: 1rpx solid #D7E5FF;
  border-radius: 999rpx;
  color: #1F2937;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  padding: 18rpx 24rpx;
}

.record-filter-active {
  background: #1677FF;
  border-color: #1677FF;
  color: #FFFFFF;
}

.record-card {
  background: #FFFFFF;
  border: 1rpx solid #E1E8EC;
  box-shadow: 0 8rpx 20rpx rgba(20, 47, 65, 0.045);
  margin-bottom: 0;
  overflow: hidden;
  position: relative;
  transform: translateX(0);
  transition: transform 180ms ease;
  width: 100%;
  z-index: 2;
}

.record-swipe-shell {
  border-radius: 24rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  position: relative;
}

.record-swipe-actions {
  align-items: stretch;
  bottom: 0;
  display: flex;
  left: 0;
  position: absolute;
  top: 0;
  width: 264rpx;
  z-index: 1;
}

.record-swipe-actions button {
  align-items: center;
  border-radius: 0;
  display: flex;
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.record-swipe-actions button::after {
  border: 0;
}

.record-swipe-actions-quotation {
  left: auto;
  right: 0;
  width: 320rpx;
}

.record-swipe-quotation-cancel {
  background: #FFF4ED;
  color: #B54708;
}

.record-swipe-quotation-convert {
  background: #1677FF;
  color: #FFFFFF;
}

.record-swipe-quotation-view {
  background: #1677FF;
  color: #FFFFFF;
}

.record-swipe-cancel {
  background: #E8EEF5;
  color: #344054;
}

.record-swipe-delete {
  background: #D92D20;
  color: #FFFFFF;
}

.record-card-swiped {
  transform: translateX(264rpx);
}

.record-card-swiped-quotation {
  transform: translateX(-320rpx);
}

.record-card::before {
  border-radius: 999rpx;
  bottom: 22rpx;
  content: "";
  left: 0;
  position: absolute;
  top: 22rpx;
  width: 8rpx;
}

.record-card-quotation {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-quotation::before {
  background: #7C3AED;
}

.record-card-order {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-order::before {
  background: #1677FF;
}

.record-card-receivable {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-receivable::before {
  background: #22C55E;
}

.record-card-payment {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-payment::before {
  background: #0EA5E9;
}

.record-card-todo {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-todo::before {
  background: #FF9500;
}

.record-card-pending {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-pending::before {
  background: #6B7280;
}

.record-card-log {
  background: #FFFFFF;
  border-color: #E1E8EC;
}

.record-card-log::before {
  background: #6366F1;
}

.record-type {
  align-items: center;
  background: #EAF2FF;
  border-radius: 999rpx;
  color: #1677FF;
  display: inline-flex;
  font-size: 24rpx;
  font-weight: 700;
  gap: 8rpx;
  padding: 8rpx 14rpx;
}

.record-type-icon {
  align-items: center;
  background: #1677FF;
  border-radius: 999rpx;
  color: #FFFFFF;
  display: flex;
  font-size: 20rpx;
  font-weight: 900;
  height: 34rpx;
  justify-content: center;
  line-height: 1;
  width: 34rpx;
}

.record-type-quotation {
  background: #F3E8FF;
  color: #7C3AED;
}

.record-type-quotation .record-type-icon {
  background: #7C3AED;
}

.record-type-order {
  background: #EAF2FF;
  color: #1677FF;
}

.record-type-order .record-type-icon {
  background: #1677FF;
}

.record-type-receivable {
  background: #ECFDF3;
  color: #16A34A;
}

.record-type-receivable .record-type-icon {
  background: #22C55E;
}

.record-type-payment {
  background: #E0F2FE;
  color: #0284C7;
}

.record-type-payment .record-type-icon {
  background: #0EA5E9;
}

.record-type-todo {
  background: #FFF7E6;
  color: #B54708;
}

.record-type-todo .record-type-icon {
  background: #FF9500;
}

.record-type-pending {
  background: #F3F4F6;
  color: #4B5563;
}

.record-type-pending .record-type-icon {
  background: #6B7280;
}

.record-type-log {
  background: #EEF2FF;
  color: #4F46E5;
}

.record-type-log .record-type-icon {
  background: #6366F1;
}

.record-time {
  color: #6B7280;
  font-size: 24rpx;
}

.record-title {
  color: #1D2D38;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-top: 18rpx;
}

.record-summary {
  color: #687782;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.record-quotation-conflict {
  background: #FFF4ED;
  border-radius: 12rpx;
  color: #B54708;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
}

.records-empty {
  margin-top: 40rpx;
}
