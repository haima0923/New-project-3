.todo-section {
  margin-bottom: 24rpx;
}

.section-title {
  color: #1677FF;
  font-size: 28rpx;
  font-weight: 700;
  margin: 10rpx 4rpx 14rpx;
}

.todo-card {
  margin-bottom: 16rpx;
}

.todo-detail {
  color: #4E606B;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.note-text {
  background: #F5F7F8;
  border-radius: 14rpx;
  color: #4E606B;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 14rpx;
  padding: 16rpx;
}

.todo-button {
  margin-top: 18rpx;
  width: 100%;
}

.empty-button {
  margin-top: 28rpx;
  width: 100%;
}
