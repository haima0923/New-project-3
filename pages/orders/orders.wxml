<view class="page">
  <view class="page-title">订单</view>
  <view class="page-subtitle">交期前 3 天和逾期订单会进入首页提醒。</view>

  <view wx:if="{{allOrders.length}}" class="compact-filter-bar">
    <input class="compact-search-input" value="{{filterKeyword}}" data-field="filterKeyword" bindinput="changeTextFilter" confirm-type="search" placeholder="搜客户或产品" />
    <button class="compact-filter-button {{hasAdvancedFilters ? 'compact-filter-button-active' : ''}}" bindtap="toggleFilters">{{showFilters ? '收起' : '筛选'}}</button>
  </view>

  <view wx:if="{{allOrders.length && showFilters}}" class="filter-panel">
    <view class="filter-panel-header">
      <view class="filter-panel-title">高级筛选</view>
      <button class="filter-panel-close" bindtap="toggleFilters">完成</button>
    </view>
    <view class="filter-grid">
      <view class="field">
        <text class="label">客户</text>
        <input class="input" value="{{filterCustomer}}" data-field="filterCustomer" bindinput="changeTextFilter" placeholder="输入客户称呼" />
      </view>
      <view class="field">
        <text class="label">产品</text>
        <input class="input" value="{{filterProduct}}" data-field="filterProduct" bindinput="changeTextFilter" placeholder="输入产品名" />
      </view>
      <view class="field">
        <text class="label">订单日期</text>
        <picker mode="date" value="{{filterOrderDate}}" data-field="filterOrderDate" bindchange="changeDateFilter">
          <view class="filter-date-input">
            <text wx:if="{{filterOrderDate}}">{{filterOrderDate}}</text>
            <text wx:else class="filter-placeholder">选择日期</text>
          </view>
        </picker>
      </view>
      <view class="field">
        <text class="label">交期</text>
        <picker mode="date" value="{{filterDueDate}}" data-field="filterDueDate" bindchange="changeDateFilter">
          <view class="filter-date-input">
            <text wx:if="{{filterDueDate}}">{{filterDueDate}}</text>
            <text wx:else class="filter-placeholder">选择日期</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="filter-footer">
      <text class="muted"><text wx:if="{{presetFilterLabel}}">{{presetFilterLabel}}，</text>显示 {{orders.length}} / {{allOrders.length}} 条</text>
      <button class="filter-reset-button" bindtap="resetFilters" disabled="{{!hasActiveFilters}}">清空筛选</button>
    </view>
  </view>

  <view wx:if="{{allOrders.length && hasActiveFilters && !showFilters}}" class="compact-filter-summary">
    <text><text wx:if="{{presetFilterLabel}}">{{presetFilterLabel}}，</text>显示 {{orders.length}} / {{allOrders.length}} 条</text>
    <text class="compact-clear-text" bindtap="resetFilters">清空</text>
  </view>

  <view wx:if="{{!allOrders.length}}" class="empty">
    <view class="card-title">还没有订单</view>
    <view class="muted">客户确认要做了，统一去“记一笔”说一句或粘贴聊天。</view>
    <button class="primary-button empty-button" bindtap="goInput">去记一笔</button>
  </view>

  <view wx:elif="{{hasActiveFilters && !orders.length}}" class="empty">
    <view class="card-title">没有符合筛选的订单</view>
    <view class="muted">换个客户、产品或日期试试。</view>
    <button class="secondary-button empty-button" bindtap="resetFilters">清空筛选</button>
  </view>

  <view wx:for="{{orders}}" wx:key="id" class="card">
    <view class="row-between">
      <view class="card-title">{{item.customerDisplay || '临时客户'}}</view>
      <view class="pill {{item.urgent ? 'pill-danger' : ''}}">{{item.status}}</view>
    </view>
    <view class="muted">{{item.itemsSummary || item.productName || '未填产品'}}</view>
    <view class="divider"></view>
    <view wx:if="{{item.hasMultipleItems}}" class="item-lines">
      <view
        wx:for="{{item.displayItems}}"
        wx:for-item="lineItem"
        wx:key="itemKey"
        class="detail-line item-detail-line"
      >
        {{lineItem.productName || '未填产品'}}
        <text wx:if="{{lineItem.quantity || lineItem.unit}}">：{{lineItem.quantity || '-'}}{{lineItem.unit || ''}}</text>
        <text wx:if="{{lineItem.unitPrice}}">，单价{{lineItem.unitPrice}}</text>
        <text wx:if="{{lineItem.totalAmount}}">，小计{{lineItem.totalAmount}}</text>
      </view>
    </view>
    <view wx:else class="detail-line">数量：{{item.quantity || '-'}}{{item.unit || ''}}</view>
    <view class="detail-line">总价：{{item.totalAmount || '-'}}</view>
    <view class="detail-line">要求交货：{{item.requiredDeliveryDate || '-'}}</view>
    <view class="detail-line">预计发货：{{item.expectedShipDate || '-'}}</view>
    <picker mode="selector" range="{{orderStatuses}}" value="{{item.statusIndex}}" data-id="{{item.id}}" bindchange="changeStatus">
      <view class="input status-picker">更新进度：{{item.status}}</view>
    </picker>
    <view class="button-row">
      <button class="secondary-button" data-id="{{item.id}}" bindtap="createReceivable">生成应收款</button>
    </view>
  </view>
</view>
