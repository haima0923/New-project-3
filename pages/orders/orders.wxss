.detail-line {
  color: #344054;
  font-size: 28rpx;
  line-height: 1.7;
}

.item-lines {
  background: #F8FAFC;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  padding: 10rpx 14rpx;
}

.item-detail-line {
  font-size: 26rpx;
}

.original-text-box {
  background: #F8FAFC;
  border-radius: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
}

.original-text-toggle {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.original-text-title {
  color: #344054;
  font-size: 26rpx;
  font-weight: 700;
}

.original-text-action {
  color: #1677FF;
  font-size: 24rpx;
}

.original-text-content {
  color: #475467;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.status-picker {
  margin-top: 18rpx;
}

.empty-button {
  margin-top: 28rpx;
  width: 100%;
}
