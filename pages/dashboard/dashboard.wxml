<view class="page home-page">
  <view class="home-hero">
    <view class="hero-main">
      <view class="hero-copy">
        <view class="hero-title">今天别漏事</view>
        <view class="hero-subtitle">按住说一句，我来帮你记、查、提醒。</view>
      </view>
      <view
        class="hero-wave {{voiceRecording ? 'hero-wave-active' : ''}}"
        bindtouchstart="startVoice"
        bindtouchmove="moveVoice"
        bindtouchend="stopVoice"
        bindtouchcancel="cancelVoice"
      >
        <view class="voice-ripple voice-ripple-left"></view>
        <view class="voice-ripple voice-ripple-right"></view>
        <view class="hero-wave-core">
          <image
            class="hero-assistant-image"
            src="/assets/characters/xiaoling/xiaoling-home-listening-v1.jpg"
            mode="aspectFill"
            aria-hidden="true"
          />
        </view>
        <view class="hero-voice-hint">{{voiceRecording ? '小玲在听' : '按住和小玲说'}}</view>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-button" bindtap="goInput">
        <view class="quick-icon quick-icon-write"></view>
        <text>打字记一笔</text>
      </view>
      <view class="quick-button" bindtap="pasteClipboard">
        <view class="quick-icon quick-icon-chat"></view>
        <text>粘贴聊天</text>
      </view>
      <view class="quick-button" bindtap="goQuery">
        <view class="quick-icon quick-icon-search"></view>
        <text>问一句</text>
      </view>
    </view>
  </view>

  <view wx:if="{{voiceTip}}" class="voice-status {{voiceRecording ? 'voice-status-active' : ''}}">{{voiceTip}}</view>

  <view wx:if="{{parseResult}}" class="confirm-modal">
    <view class="card home-confirm-card confirm-modal-card">
      <view class="confirm-card-header">
        <view class="confirm-card-heading">
          <view class="card-title">请确认，再保存</view>
          <view class="muted">{{parseResult.confirm_message}}</view>
        </view>
        <view class="confirm-card-header-actions">
          <view class="pill">{{sourceLabel}}</view>
          <button class="confirm-close-button" bindtap="closeConfirmCard" aria-label="关闭确认卡">×</button>
        </view>
      </view>
      <scroll-view scroll-y="true" class="confirm-modal-body">
      <view wx:if="{{parseResult.extracted_text}}" class="confirm-original">
        <view class="confirm-original-label">整理出的内容</view>
        <view class="confirm-original-text">{{parseResult.extracted_text}}</view>
      </view>
      <view class="confirm-original">
        <view class="confirm-original-label">{{parseResult.raw_text ? '原始聊天内容' : '你刚才输入的内容'}}</view>
        <view class="confirm-original-text">{{parseResult.original_text}}</view>
      </view>
      <view wx:if="{{parseEvidence}}" class="parse-evidence-card">
        <view class="parse-evidence-title">本次整理说明</view>
        <view class="parse-evidence-line">{{parseEvidence.routeLabel}} · <text class="parse-evidence-status parse-evidence-status-{{parseEvidence.aiTone}}">{{parseEvidence.aiStatusText}}</text> · {{parseEvidence.totalDurationText}}</view>
        <view class="parse-evidence-toggle" bindtap="toggleParseEvidence">{{showParseEvidence ? '收起整理说明' : '查看整理说明'}}</view>
        <view wx:if="{{showParseEvidence}}" class="parse-evidence-detail"><text class="parse-evidence-label">{{parseEvidence.sourceTextLabel}}：</text>{{parseEvidence.sourceText}}</view>
        <view wx:if="{{showParseEvidence}}" class="parse-evidence-detail"><text class="parse-evidence-label">为什么这样处理：</text>{{parseEvidence.routeReasons}}</view>
        <view wx:if="{{showParseEvidence}}" class="parse-evidence-detail"><text class="parse-evidence-label">本地先整理成：</text>{{parseEvidence.localSummary}}</view>
        <view wx:if="{{showParseEvidence && parseEvidence.aiSummary}}" class="parse-evidence-detail"><text class="parse-evidence-label">AI 回答：</text>{{parseEvidence.aiSummary}}</view>
        <view wx:if="{{showParseEvidence}}" class="parse-evidence-detail"><text class="parse-evidence-label">等待时间：</text>本地 {{parseEvidence.localDurationText}}；联网整理 {{parseEvidence.aiDurationText}}；总共 {{parseEvidence.totalDurationText}}{{parseEvidence.networkWaitLimitText ? '；最多等 ' + parseEvidence.networkWaitLimitText : ''}}</view>
        <view wx:if="{{showParseEvidence && parseEvidence.aiRequestId}}" class="parse-evidence-detail"><text class="parse-evidence-label">本次核对编号：</text>{{parseEvidence.aiRequestId}}{{parseEvidence.aiModelTier ? '；方式：' + parseEvidence.aiModelTier : ''}}{{parseEvidence.aiServerElapsedText ? '；服务端：' + parseEvidence.aiServerElapsedText : ''}}</view>
        <view wx:if="{{showParseEvidence}}" class="parse-evidence-detail">{{parseEvidence.aiDetail}}</view>
        <view wx:if="{{showParseEvidence}}" class="parse-evidence-check">核对提醒：{{parseEvidence.checkText}}</view>
      </view>
      <view wx:if="{{showFieldConflicts}}" class="confirm-warning">
        <view wx:for="{{fieldConflictLines}}" wx:key="*this">{{item}}</view>
      </view>
      <view wx:if="{{showSupersededFacts}}" class="confirm-conversation">
        <view class="confirm-original-label">后面的聊天有新说法</view>
        <view wx:for="{{supersededFactLines}}" wx:key="*this" class="confirm-conversation-line">{{item}}</view>
      </view>
      <view wx:if="{{showRemarkItems}}" class="confirm-conversation">
        <view class="confirm-original-label">客户特别交代</view>
        <view wx:for="{{remarkItemLines}}" wx:key="*this" class="confirm-conversation-line">{{item}}</view>
      </view>
      <view wx:if="{{confirmFields.length}}" class="confirm-fields">
        <view wx:for="{{confirmFields}}" wx:key="field" class="confirm-edit-field {{item.warning ? 'confirm-field-warning' : ''}}">
          <text class="confirm-label">{{item.label}}</text>
          <picker
            wx:if="{{item.kind === 'date'}}"
            mode="date"
            value="{{item.value}}"
            start="2020-01-01"
            end="2035-12-31"
            data-field="{{item.field}}"
            bindchange="changeConfirmDate"
          >
            <view class="confirm-input confirm-date-input">
              <text wx:if="{{item.value}}">{{item.value}}</text>
              <text wx:else class="confirm-placeholder">点击选择日期</text>
              <text class="confirm-picker-arrow">选择</text>
            </view>
          </picker>
          <textarea
            wx:elif="{{item.kind === 'textarea'}}"
            class="confirm-input confirm-textarea"
            value="{{item.value}}"
            maxlength="-1"
            data-field="{{item.field}}"
            bindinput="updateConfirmField"
            placeholder="补充备注"
          />
          <input
            wx:else
            class="confirm-input"
            value="{{item.value}}"
            data-field="{{item.field}}"
            type="{{item.inputType}}"
            bindinput="updateConfirmField"
            placeholder="请补充"
          />
          <view wx:if="{{item.warning}}" class="confirm-field-tip">{{item.warning}}</view>
          <view wx:if="{{item.suggestionText}}" class="confirm-field-tip" data-field="{{item.field}}" data-value="{{item.suggestionValue}}" bindtap="applyConfirmSuggestion">{{item.suggestionText}} 点这里采用建议</view>
        </view>
      </view>
      <view wx:if="{{warningText}}" class="confirm-warning">{{warningText}}</view>
      </scroll-view>
      <view wx:if="{{isNoRecord}}" class="confirm-warning">{{noRecordMessage}}</view>
      <view class="button-row confirm-action-row">
        <button wx:if="{{showDeepReviewButton}}" class="secondary-button" bindtap="requestDeepReview">深度核对</button>
        <button wx:if="{{showContinueInput}}" class="secondary-button" bindtap="continueInput">打开完整记一笔</button>
        <button wx:if="{{showPendingButton}}" class="secondary-button" bindtap="savePendingFromConfirm">先放待整理</button>
        <button wx:if="{{showFormalSaveButton}}" class="primary-button" disabled="{{disableQuickSave}}" bindtap="confirmQuickSave">{{quickSaveText}}</button>
      </view>
    </view>
  </view>

  <view class="today-card">
    <view class="today-card-head">
      <view class="section-title">今天要处理</view>
      <view class="section-count">{{taskTotal}}</view>
      <view class="section-link" bindtap="goTodos">全部处理 ></view>
    </view>

    <view wx:if="{{!tasks.length}}" class="soft-empty">
      <view class="soft-empty-title">今天暂时没有急事</view>
      <view class="muted">有新报价、订单、收款或提醒，我会放到这里。</view>
    </view>

    <view wx:else class="task-list">
      <view
        wx:for="{{tasks}}"
        wx:key="id"
        wx:for-index="taskIndex"
        class="task-row task-row-{{taskIndex}}"
        data-type="{{item.type}}"
        bindtap="handleTaskAction"
      >
        <view class="task-icon task-icon-index-{{taskIndex}} task-icon-type-{{item.type}}">{{item.icon}}</view>
        <view class="task-main">
          <view class="task-title-row">
            <view class="task-title">{{item.title}}</view>
            <view class="task-badge task-badge-{{item.tone}}">{{item.badge}}</view>
          </view>
          <view class="task-company">{{item.company}}</view>
          <view class="task-detail">{{item.detail}}</view>
        </view>
        <view class="task-action">{{item.actionLabel}}</view>
      </view>
    </view>
  </view>

  <view class="recent-card">
    <view class="recent-card-head">
      <view class="section-title">最近记下的</view>
      <view class="section-link" bindtap="goRecords">全部记录 ></view>
    </view>

    <view wx:if="{{!recentRecords.length}}" class="recent-list recent-list-empty">
      <view class="recent-line">
        <view class="recent-icon-shell">
          <view class="recent-mini-icon"></view>
        </view>
        <view class="recent-text">还没有记录，先从底部输入一句。</view>
      </view>
    </view>

    <view wx:else class="recent-list">
      <view wx:for="{{recentRecords}}" wx:key="id" class="recent-line" data-type="{{item.type}}" data-id="{{item.sourceId || item.id}}" bindtap="openRecent">
        <view class="recent-icon-shell recent-icon-type-{{item.type}}">
          <view class="recent-mini-icon"></view>
        </view>
        <view class="recent-text">{{item.title}}</view>
        <view class="recent-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <view class="home-composer">
    <view class="composer-input-shell">
      <view class="composer-keyboard-icon">
        <view class="keyboard-row keyboard-row-top">
          <view></view>
          <view></view>
          <view></view>
        </view>
        <view class="keyboard-row keyboard-row-bottom">
          <view></view>
          <view></view>
        </view>
      </view>
      <input
        class="composer-input"
        value="{{composerText}}"
        maxlength="-1"
        placeholder="记下报价、订单、收款，或粘贴聊天..."
        confirm-type="send"
        bindinput="onComposerInput"
        bindconfirm="submitComposer"
      />
      <button class="composer-plus" bindtap="pasteClipboard">+</button>
    </view>
  </view>

  <view wx:if="{{voiceOverlayVisible}}" class="voice-overlay voice-overlay-{{voiceOverlayMode}} voice-gesture-{{voiceGesture}}">
    <view class="voice-overlay-panel">
      <view class="voice-overlay-title">{{voiceOverlayTitle}}</view>
      <view wx:if="{{voiceOverlayMode === 'listening'}}" class="voice-overlay-subtitle">{{voiceOverlaySubtitle}}</view>
      <view wx:if="{{voiceOverlayMode === 'listening'}}" class="voice-overlay-mic">
        <view class="voice-overlay-wave voice-overlay-wave-left"></view>
        <view class="voice-overlay-wave voice-overlay-wave-right"></view>
        <view class="voice-overlay-mic-core">
          <view class="mic-symbol mic-symbol-large">
            <view class="mic-body"></view>
            <view class="mic-stem"></view>
            <view class="mic-base"></view>
          </view>
        </view>
      </view>
      <view wx:else class="voice-progress-box">
        <view class="voice-progress-track">
          <view class="voice-progress-line"></view>
        </view>
      </view>
      <view wx:if="{{voiceOverlayMode === 'processing'}}" class="voice-processing-note">{{voiceOverlaySubtitle}}</view>
      <view wx:if="{{voiceOverlayMode === 'listening'}}" class="voice-slide-targets">
        <view class="voice-slide-target voice-slide-cancel">取消输入</view>
        <view class="voice-slide-target voice-slide-input">转到文字输入</view>
      </view>
    </view>
  </view>
</view>
