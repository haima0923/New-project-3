<view class="page home-page">
  <view class="home-hero">
    <view class="hero-main">
      <view class="hero-copy">
        <view class="hero-title">今天别漏事</view>
        <view class="hero-subtitle">按住说一句，我来帮你记、查、提醒。</view>
      </view>
      <view
        class="hero-wave {{voiceRecording ? 'hero-wave-active' : ''}} {{voiceCapturePhase === 'READY_RECORDING' ? 'hero-wave-ready' : ''}}"
        bindtouchstart="startVoice"
        bindtouchmove="moveVoice"
        bindtouchend="stopVoice"
        bindtouchcancel="cancelVoice"
      >
        <view class="voice-ripple voice-ripple-left"></view>
        <view class="voice-ripple voice-ripple-right"></view>
        <view class="hero-wave-core">
          <view
            wx:if="{{voiceCapturePhase === 'POST_ONSTART_STABILIZING' || voiceCapturePhase === 'READY_RECORDING'}}"
            class="voice-readiness-fill hero-readiness-fill {{voiceCapturePhase === 'POST_ONSTART_STABILIZING' ? 'voice-readiness-fill-filling' : 'voice-readiness-fill-full'}}"
          ></view>
          <image
            class="hero-assistant-image"
            src="/assets/characters/xiaoling/xiaoling-home-listening-v1.jpg"
            mode="aspectFill"
            aria-hidden="true"
          />
        </view>
        <view class="hero-voice-hint">{{voiceCapturePhase === 'PREPARING' || voiceCapturePhase === 'POST_ONSTART_STABILIZING' ? '准备中…' : (voiceCapturePhase === 'READY_RECORDING' || voiceCapturePhase === 'CANCEL_PENDING' ? '我在听' : '按住和小玲说')}}</view>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-button" bindtap="goInput">
        <view class="quick-icon quick-icon-write"></view>
        <text>打字记一笔</text>
      </view>
      <view class="quick-button" bindtap="pasteClipboard">
        <view class="quick-icon quick-icon-chat"></view>
        <text>粘贴聊天</text>
      </view>
      <view class="quick-button" bindtap="goQuery">
        <view class="quick-icon quick-icon-search"></view>
        <text>问一句</text>
      </view>
    </view>
  </view>

  <view wx:if="{{voiceTip}}" class="voice-status {{voiceRecording ? 'voice-status-active' : ''}}">{{voiceTip}}</view>

  <view class="today-card">
    <view class="today-card-head">
      <view class="section-title">今天要处理</view>
      <view class="section-count">{{taskTotal}}</view>
      <view class="section-link" bindtap="goTodos">全部处理 ></view>
    </view>

    <view wx:if="{{!tasks.length}}" class="soft-empty">
      <view class="soft-empty-title">今天暂时没有急事</view>
      <view class="muted">有新报价、订单、收款或提醒，我会放到这里。</view>
    </view>

    <view wx:else class="task-list">
      <view
        wx:for="{{tasks}}"
        wx:key="id"
        wx:for-index="taskIndex"
        class="task-row task-row-{{taskIndex}}"
        data-type="{{item.type}}"
        bindtap="handleTaskAction"
      >
        <view class="task-icon task-icon-index-{{taskIndex}} task-icon-type-{{item.type}}">{{item.icon}}</view>
        <view class="task-main">
          <view class="task-title-row">
            <view class="task-title">{{item.title}}</view>
            <view class="task-badge task-badge-{{item.tone}}">{{item.badge}}</view>
          </view>
          <view class="task-company">{{item.company}}</view>
          <view class="task-detail">{{item.detail}}</view>
        </view>
        <view class="task-action">{{item.actionLabel}}</view>
      </view>
    </view>
  </view>

  <view class="recent-card">
    <view class="recent-card-head">
      <view class="section-title">最近记下的</view>
      <view class="section-link" bindtap="goRecords">全部记录 ></view>
    </view>

    <view wx:if="{{!recentRecords.length}}" class="recent-list recent-list-empty">
      <view class="recent-line">
        <view class="recent-icon-shell">
          <view class="recent-mini-icon"></view>
        </view>
        <view class="recent-text">还没有记录，先从底部输入一句。</view>
      </view>
    </view>

    <view wx:else class="recent-list">
      <view wx:for="{{recentRecords}}" wx:key="id" class="recent-line" data-type="{{item.type}}" data-id="{{item.sourceId || item.id}}" bindtap="openRecent">
        <view class="recent-icon-shell recent-icon-type-{{item.type}}">
          <view class="recent-mini-icon"></view>
        </view>
        <view class="recent-text">{{item.title}}</view>
        <view class="recent-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <view class="home-composer">
    <view class="composer-input-shell">
      <view class="composer-keyboard-icon">
        <view class="keyboard-row keyboard-row-top">
          <view></view>
          <view></view>
          <view></view>
        </view>
        <view class="keyboard-row keyboard-row-bottom">
          <view></view>
          <view></view>
        </view>
      </view>
      <input
        class="composer-input"
        value="{{composerText}}"
        maxlength="-1"
        placeholder="记下报价、订单、收款，或粘贴聊天..."
        confirm-type="send"
        bindinput="onComposerInput"
        bindconfirm="submitComposer"
      />
      <button class="composer-plus" bindtap="pasteClipboard">+</button>
    </view>
  </view>

  <view wx:if="{{voiceOverlayVisible}}" class="voice-overlay voice-overlay-{{voiceOverlayMode}} voice-gesture-{{voiceGesture}} {{voiceCapturePhase === 'READY_RECORDING' ? 'voice-overlay-ready' : ''}}">
    <view class="voice-overlay-panel">
      <view class="voice-overlay-title">{{voiceOverlayTitle}}</view>
      <view wx:if="{{voiceOverlayMode === 'listening' || voiceOverlayMode === 'preparing'}}" class="voice-overlay-subtitle">{{voiceOverlaySubtitle}}</view>
      <view wx:if="{{voiceOverlayMode === 'listening' || voiceOverlayMode === 'preparing'}}" class="voice-overlay-mic">
        <view class="voice-overlay-wave voice-overlay-wave-left"></view>
        <view class="voice-overlay-wave voice-overlay-wave-right"></view>
        <view class="voice-overlay-mic-core">
          <view
            wx:if="{{voiceCapturePhase === 'POST_ONSTART_STABILIZING' || voiceCapturePhase === 'READY_RECORDING'}}"
            class="voice-readiness-fill overlay-readiness-fill {{voiceCapturePhase === 'POST_ONSTART_STABILIZING' ? 'voice-readiness-fill-filling' : 'voice-readiness-fill-full'}}"
          ></view>
          <view class="mic-symbol mic-symbol-large">
            <view class="mic-body"></view>
            <view class="mic-stem"></view>
            <view class="mic-base"></view>
          </view>
        </view>
      </view>
      <view wx:elif="{{voiceOverlayMode === 'processing'}}" class="voice-progress-box">
        <view class="voice-progress-track">
          <view class="voice-progress-line"></view>
        </view>
      </view>
      <view wx:if="{{voiceOverlayMode === 'processing'}}" class="voice-processing-note">{{voiceOverlaySubtitle}}</view>
      <view wx:if="{{voiceOverlayMode === 'listening' || voiceOverlayMode === 'preparing'}}" class="voice-slide-targets">
        <view class="voice-slide-target voice-slide-cancel">上滑取消</view>
      </view>
    </view>
  </view>
</view>
