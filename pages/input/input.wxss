.input-page {
  background: #F6F8FC;
}

.input-entry-card {
  border-color: #D7E8FF;
}

.segmented {
  background: #EEF5FF;
  border-radius: 18rpx;
  display: grid;
  gap: 6rpx;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 20rpx;
  padding: 6rpx;
}

.segment {
  border-radius: 14rpx;
  color: #64748B;
  font-size: 28rpx;
  padding: 18rpx 8rpx;
  text-align: center;
}

.segment.active {
  background: #ffffff;
  color: #1677FF;
  font-weight: 700;
}

.parse-button {
  margin-top: 20rpx;
}

.parse-progress-card {
  align-items: center;
  background: #EEF6FF;
  border: 1rpx solid #D7E8FF;
  border-radius: 20rpx;
  display: flex;
  gap: 16rpx;
  margin: 18rpx 0 22rpx;
  padding: 18rpx 20rpx;
}

.parse-progress-orbit {
  align-items: center;
  border: 4rpx solid rgba(22, 119, 255, 0.18);
  border-radius: 999rpx;
  display: flex;
  flex: 0 0 44rpx;
  height: 44rpx;
  justify-content: center;
  position: relative;
  width: 44rpx;
}

.parse-progress-dot {
  background: #1677FF;
  border-radius: 999rpx;
  box-shadow: 0 0 0 8rpx rgba(22, 119, 255, 0.12);
  height: 14rpx;
  width: 14rpx;
}

.parse-progress-orbit::after {
  background: #1677FF;
  border-radius: 999rpx;
  content: "";
  height: 10rpx;
  position: absolute;
  right: -5rpx;
  top: 2rpx;
  width: 10rpx;
  animation: parseProgressOrbit 1.2s linear infinite;
  transform-origin: -20rpx 20rpx;
}

.parse-progress-copy {
  min-width: 0;
}

.parse-progress-title {
  color: #175EA8;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.parse-progress-detail {
  color: #54779C;
  font-size: 23rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

@keyframes parseProgressOrbit {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.paste-tip {
  line-height: 1.5;
  margin: -4rpx 0 16rpx;
}

.input-confirm-modal {
  align-items: flex-end;
  background: rgba(13, 32, 45, 0.44);
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  left: 0;
  padding: 0 20rpx calc(176rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1320;
}

.input-confirm-card {
  border: 1rpx solid #E5EAF2;
  border-radius: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 40rpx rgba(13, 32, 45, 0.18);
  display: flex;
  flex-direction: column;
  height: calc(100vh - 196rpx - env(safe-area-inset-bottom));
  margin-bottom: 0;
  overflow: hidden;
  padding: 32rpx;
  width: 100%;
}

.input-confirm-body {
  flex: 1;
  height: 0;
  margin-top: 16rpx;
  min-height: 0;
  padding-right: 4rpx;
}

.input-confirm-card .button-row {
  background: #FFFFFF;
  border-top: 1rpx solid #E5EAF2;
  margin-bottom: 0;
  margin-top: 16rpx;
  padding-top: 18rpx;
  position: static;
}

.input-confirm-card .confirm-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.input-confirm-card .confirm-action-row button {
  min-width: 0;
}

.input-confirm-card .confirm-action-row button:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.input-confirm-header {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.input-confirm-heading {
  flex: 1;
  min-width: 0;
}

.input-confirm-header-actions {
  align-items: center;
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
}

.input-confirm-close-button {
  align-items: center;
  background: #F1F5F9;
  border: 0;
  border-radius: 999rpx;
  color: #475467;
  display: flex;
  font-size: 42rpx;
  font-weight: 400;
  height: 56rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  min-height: 56rpx;
  padding: 0;
  width: 56rpx;
}

.input-confirm-close-button:active {
  background: #E2E8F0;
}

.assist-box,
.computed-box {
  background: #EEF6FF;
  border-radius: 16rpx;
  color: #2563A7;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 16rpx;
  padding: 16rpx;
}

.field-tip {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.paste-original-text {
  white-space: pre-wrap;
}

.date-picker-input {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.placeholder-text {
  color: #98a2b3;
}

.picker-arrow {
  color: #1677FF;
  font-size: 24rpx;
  font-weight: 700;
}

.operation-box,
.draft-box,
.customer-match-box,
.payment-confirm-box,
.payment-preview {
  background: #F7FAFF;
  border-radius: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx;
}

.customer-match-box {
  border: 1rpx solid #D7E8FF;
  margin-bottom: 18rpx;
}

.order-selection-box {
  background: #F7FAFF;
  border: 1rpx solid #D7E8FF;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  margin-top: 16rpx;
  padding: 16rpx;
}

.order-selection-head {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.order-selection-reason {
  color: #475467;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.order-selection-required {
  background: #fff1f3;
  border-radius: 999rpx;
  color: #b42318;
  flex: 0 0 auto;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
}

.order-candidate {
  background: #FFFFFF;
  border: 1rpx solid #E4E7EC;
  border-radius: 12rpx;
  margin-top: 12rpx;
  padding: 14rpx;
}

.order-candidate-selected {
  border-color: #1677FF;
  box-shadow: 0 0 0 2rpx rgba(22, 119, 255, 0.08);
}

.order-candidate-title {
  color: #101828;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.order-candidate-meta {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

.order-selection-clear {
  font-size: 25rpx;
  margin-top: 12rpx;
  min-height: 72rpx;
  width: 100%;
}

.match-line {
  color: #344054;
  font-size: 26rpx;
  line-height: 1.5;
}

.match-picker-field {
  margin-top: 14rpx;
}

.customer-history-box {
  background: #ffffff;
  border: 1rpx solid #e4e7ec;
  border-radius: 12rpx;
  margin-top: 14rpx;
  padding: 14rpx;
}

.history-title {
  color: #101828;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.history-line {
  color: #475467;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.history-action-row {
  display: grid;
  gap: 12rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 14rpx;
}

.history-confirm-button {
  font-size: 26rpx;
  min-height: 76rpx;
  padding: 18rpx 12rpx;
}

.operation-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.draft-line,
.preview-line {
  color: #344054;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

.conversation-box {
  background: #EEF6FF;
}

.payment-warning {
  background: #fff7e6;
  border-radius: 10rpx;
  color: #8a4b00;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 12rpx;
  padding: 12rpx;
}

.history-default-box {
  background: #fff8f6;
  border: 1rpx solid #fecdca;
  border-radius: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.history-default-line {
  color: #b42318;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
  margin-top: 8rpx;
}

.history-default-input {
  border-color: #f04438;
  box-shadow: 0 0 0 2rpx rgba(240, 68, 56, 0.08);
  color: #b42318;
  font-weight: 700;
}

.followup-card {
  background: #fff8f6;
  border: 1rpx solid #fecdca;
  border-radius: 14rpx;
  padding: 18rpx;
}

.followup-card-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.followup-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.followup-subtitle {
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 2rpx;
}

.followup-default-pill {
  background: #fff1f3;
  border-radius: 999rpx;
  color: #b42318;
  font-size: 22rpx;
  padding: 10rpx 14rpx;
}

.followup-picker {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #fda29b;
  border-radius: 12rpx;
  color: #b42318;
  display: flex;
  font-size: 30rpx;
  font-weight: 700;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 0 18rpx;
}

.followup-warning {
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 12rpx;
}

.voice-box {
  margin-bottom: 20rpx;
}

.voice-button {
  align-items: center;
  border: 0;
  border-radius: 20rpx;
  box-sizing: border-box;
  display: flex;
  font-size: 30rpx;
  font-weight: 800;
  justify-content: center;
  min-height: 132rpx;
  width: 100%;
}

.voice-button::after {
  border: 0;
}

.voice-button-idle {
  background: linear-gradient(135deg, #3F94FF 0%, #1677FF 72%, #0B5ED7 100%);
  box-shadow: 0 12rpx 24rpx rgba(22, 119, 255, 0.22);
  color: #FFFFFF;
}

.voice-button-recording {
  background: linear-gradient(135deg, #FFB020 0%, #FF7A00 74%, #F05A28 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 0, 0.24);
  color: #FFFFFF;
}

.voice-tip {
  color: #52708E;
  margin-top: 12rpx;
  min-height: 38rpx;
}

.small-textarea {
  min-height: 150rpx;
}

.item-list-field {
  margin-bottom: 22rpx;
}

.confirm-item-card {
  background: #f8fafc;
  border: 1rpx solid #e4e7ec;
  border-radius: 14rpx;
  margin-top: 12rpx;
  padding: 18rpx;
}

.confirm-item-head {
  align-items: center;
  color: #101828;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  justify-content: space-between;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.confirm-item-remove {
  color: #D92D20;
  font-size: 24rpx;
  font-weight: 500;
}

.confirm-item-add {
  background: #F5F8FF;
  border: 1rpx dashed #9DBBFF;
  color: #1677FF;
  font-size: 26rpx;
  margin-top: 14rpx;
  width: 100%;
}

.item-field {
  margin-bottom: 14rpx;
}

.catalog-suggestion-box {
  margin-top: 10rpx;
}

.catalog-suggestion-label {
  color: #667085;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.catalog-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.catalog-chip {
  background: #EAF2FF;
  border: 1rpx solid #C7DAFF;
  border-radius: 999rpx;
  color: #1677FF;
  font-size: 23rpx;
  padding: 9rpx 14rpx;
}

.catalog-check-hint {
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.45;
  margin: 2rpx 0 14rpx;
  padding: 10rpx 12rpx;
}

.catalog-check-known {
  background: #ECFDF3;
  color: #067647;
}

.catalog-check-new {
  background: #FFF7E6;
  color: #B54708;
}

.confirm-item-card .grid-2:last-child .item-field {
  margin-bottom: 0;
}

.item-meta-line {
  color: #475467;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 10rpx;
}

.order-amount-summary {
  background: #f8fafc;
  border: 1rpx solid #e4e7ec;
  border-radius: 14rpx;
  margin: 14rpx 0 22rpx;
  padding: 16rpx 18rpx;
}

.amount-summary-line {
  align-items: center;
  display: flex;
  justify-content: space-between;
  line-height: 1.5;
  margin-top: 8rpx;
}

.amount-summary-line:first-child {
  margin-top: 0;
}

.amount-summary-label {
  color: #475467;
  font-size: 26rpx;
}

.amount-summary-value {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.warning-box {
  background: #fff7e6;
  border-radius: 14rpx;
  margin-top: 18rpx;
  padding: 20rpx;
}

.warning-line {
  color: #8a4b00;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.parse-evidence-card {
  background: #F3F8FF;
  border: 1rpx solid #CFE3FF;
  border-radius: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.parse-evidence-title {
  color: #174A7C;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.parse-evidence-line,
.parse-evidence-detail,
.parse-evidence-check {
  color: #344054;
  font-size: 25rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  white-space: pre-wrap;
}

.parse-evidence-label {
  color: #2563A7;
  font-weight: 800;
}

.parse-evidence-status {
  font-weight: 800;
}

.parse-evidence-status-success {
  color: #027A48;
}

.parse-evidence-status-warning {
  color: #B54708;
}

.parse-evidence-status-neutral {
  color: #475467;
}

.parse-evidence-toggle {
  color: #1677FF;
  font-size: 25rpx;
  font-weight: 800;
  margin-top: 12rpx;
}

.parse-evidence-check {
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-top: 12rpx;
  padding: 10rpx 12rpx;
}
