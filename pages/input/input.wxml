<view class="page input-page">
  <view class="page-title">记一笔</view>
  <view class="page-subtitle">说一句、打一段或粘贴聊天；我先整理好，你确认后再保存。</view>

  <view class="card input-entry-card">
      <view class="segmented">
        <view class="{{typedClass}}" data-source="typed" bindtap="setSource">手动输入</view>
        <view class="{{pasteClass}}" data-source="paste" bindtap="setSource">粘贴聊天</view>
        <view class="{{voiceClass}}" data-source="voice" bindtap="setSource">语音</view>
      </view>

    <view wx:if="{{showPaste}}" class="button-row">
      <button class="secondary-button" bindtap="pasteClipboard">读取剪贴板</button>
      <button class="secondary-button" bindtap="appendClipboard">追加一条</button>
    </view>
    <view wx:if="{{showPaste}}" class="muted paste-tip">如果读取剪贴板只读到 1 条，请长按下面输入框粘贴完整聊天。</view>

    <view wx:if="{{showVoice}}" class="voice-box">
      <button
        class="{{voiceButtonClass}} voice-button"
        bindtouchstart="startVoice"
        bindtouchend="stopVoice"
        bindtouchcancel="cancelVoice"
      >
        {{voiceButtonText}}
      </button>
      <view class="muted voice-tip">{{voiceTip}}</view>
    </view>

    <textarea
      class="textarea"
      value="{{text}}"
      maxlength="-1"
      placeholder="例如：给王总报 1000 个水杯，5 块 5 一个，月底交。也可以直接粘贴聊天。"
      bindinput="onTextInput"
    />
    <button class="primary-button parse-button" loading="{{parsing}}" disabled="{{parsing}}" bindtap="runParse">
      {{parseButtonText}}
    </button>
  </view>

  <view wx:if="{{showParseProgress}}" class="parse-progress-card">
    <view class="parse-progress-orbit"><view class="parse-progress-dot"></view></view>
    <view class="parse-progress-copy">
      <view class="parse-progress-title">{{parseProgressTitle}}</view>
      <view class="parse-progress-detail">{{parseProgressDetail}}</view>
    </view>
  </view>

  <view wx:if="{{parseResult}}" class="input-confirm-modal">
    <view class="card input-confirm-card">
    <view class="input-confirm-header">
      <view class="input-confirm-heading">
        <view class="card-title surface-confirm-title">{{surfaceConfirmTitle}}</view>
      </view>
    <view class="input-confirm-header-actions">
        <button class="input-confirm-close-button" bindtap="closeConfirmCard" aria-label="关闭确认卡">×</button>
      </view>
    </view>
    <scroll-view scroll-y="true" class="input-confirm-body">
    <view
      wx:if="{{activeQuestion}}"
      class="assistant-question-card"
      data-surface-role="active-question"
    >
      <view class="assistant-question-eyebrow">小玲有一个地方没听明白</view>
      <view class="assistant-question-prompt">{{activeQuestion.prompt}}</view>
      <input
        class="input assistant-answer-input"
        value="{{assistantAnswerValue}}"
        bindinput="updateAssistantAnswer"
        placeholder="请输入答案"
      />
      <button
        class="primary-button assistant-answer-button"
        bindtap="submitAssistantAnswer"
        data-question-id="{{activeQuestion.questionId}}"
        data-revision="{{activeQuestion.draftRevision}}"
        data-original-text-fingerprint="{{activeQuestion.originalTextFingerprint}}"
        data-field="{{activeQuestion.target.field}}"
        data-field-path="{{activeQuestion.target.fieldPath}}"
        data-item-key="{{activeQuestion.target.itemKey}}"
      >确认</button>
    </view>

    <view
      wx:if="{{assistantQuestionState === 'SAFE_BLOCKED'}}"
      class="safe-blocked-surface"
      data-surface-role="safe-blocked"
    >
      <view class="safe-blocked-message">{{safeBlockedMessage}}</view>
      <button class="secondary-button safe-blocked-action" bindtap="returnToInput">重新输入原话</button>
    </view>

    <view class="field">
      <text class="label">业务类型</text>
      <picker mode="selector" range="{{intentRange}}" bindchange="changeIntent">
        <view class="input">{{intentLabel}}</view>
      </picker>
    </view>

    <view wx:if="{{showTodoTitleField}}" class="field">
      <text class="label">待办事项</text>
      <input class="input" value="{{fields.todoTitle}}" data-field="todoTitle" bindinput="updateField" placeholder="例如：回复周姐礼品盒报价" />
    </view>
    <view wx:if="{{showCustomerFields}}" class="field surface-field {{riskByField.customerName ? 'surface-field-error' : ''}}">
      <text class="label">客户称呼</text>
      <input class="input {{riskByField.customerName ? 'surface-input-error' : ''}}" value="{{fields.customerName}}" data-field="customerName" bindinput="updateField" />
      <view wx:if="{{riskByField.customerName}}" class="surface-field-risk">{{riskByField.customerName.message}}</view>
    </view>
    <view wx:if="{{showPhoneField}}" class="field">
      <text class="label">手机号（可选）</text>
      <input class="input" value="{{fields.phone}}" data-field="phone" bindinput="updateField" type="number" />
    </view>
    <view wx:if="{{showCustomerMatchBox}}" class="customer-match-box">
      <view class="card-title">客户匹配</view>
      <view wx:if="{{customerMatchText}}" class="match-line">{{customerMatchText}}</view>
      <view wx:if="{{showCustomerPicker}}" class="field match-picker-field">
        <text class="label">这笔业务属于谁</text>
        <picker mode="selector" range="{{customerMatchRange}}" value="{{selectedCustomerIndex}}" bindchange="changeCustomerMatch">
          <view class="input date-picker-input">
            <text wx:if="{{selectedCustomerIndex >= 0}}">{{selectedCustomerLabel}}</text>
            <text wx:else class="placeholder-text">请选择客户</text>
            <text class="picker-arrow">选择</text>
          </view>
        </picker>
      </view>
      <view wx:if="{{showCustomerDisambiguationField}}" class="field match-picker-field">
        <text class="label">客户区分备注</text>
        <input class="input" value="{{fields.customerNote}}" data-field="customerNote" bindinput="updateField" placeholder="例如：一区王总、眼镜厂王总、朋友介绍" />
      </view>
      <view wx:if="{{customerHistoryTitle}}" class="customer-history-box">
        <view class="history-title">{{customerHistoryTitle}}</view>
        <view wx:for="{{customerHistoryLines}}" wx:key="*this" class="history-line">{{item}}</view>
        <view wx:if="{{showCustomerHistoryConfirm}}" class="history-action-row">
          <button class="secondary-button history-confirm-button" bindtap="confirmCustomerHistory">
            确认新增一笔
          </button>
          <button class="secondary-button history-confirm-button" bindtap="createNewCustomerOrder">
            创建全新客户订单
          </button>
        </view>
      </view>
      <view wx:if="{{customerMatchWarningText}}" class="payment-warning">{{customerMatchWarningText}}</view>
    </view>
    <view wx:if="{{showGenericOrderSelection}}" class="order-selection-box">
      <view class="order-selection-head">
        <view>
          <view class="card-title">选择关联订单</view>
          <view class="order-selection-reason">{{orderSelectionReason}}</view>
        </view>
        <view wx:if="{{orderSelectionRequired}}" class="order-selection-required">必须选择</view>
      </view>
      <view wx:for="{{orderCandidates}}" wx:key="id" class="order-candidate {{item.id === selectedOrderId ? 'order-candidate-selected' : ''}}">
        <view class="order-candidate-title">{{item.customerDisplayName}} · {{item.productSummary}}</view>
        <view class="order-candidate-meta">
          {{item.itemCount}}项 · {{item.status || '-'}} · 交期{{item.dueDate || '-'}}
        </view>
        <view wx:if="{{item.orderAmount}}" class="order-candidate-meta">订单金额：{{item.orderAmount}}元</view>
      </view>
      <view wx:if="{{showGenericOrderPicker}}" class="field match-picker-field">
        <text class="label">原话指的是哪一单</text>
        <picker mode="selector" range="{{orderRange}}" value="{{selectedOrderIndex}}" bindchange="changeOrder">
          <view class="input date-picker-input">
            <text wx:if="{{selectedOrderIndex >= 0}}">{{selectedOrderLabel}}</text>
            <text wx:else class="placeholder-text">请选择订单</text>
            <text class="picker-arrow">选择</text>
          </view>
        </picker>
      </view>
      <button wx:if="{{selectedOrderId}}" class="secondary-button order-selection-clear" bindtap="clearOrderSelection">取消关联</button>
    </view>
    <view wx:if="{{showGenericQuotationSelection}}" class="order-selection-box quotation-selection-box">
      <view class="order-selection-head">
        <view>
          <view class="card-title">选择关联报价</view>
          <view class="order-selection-reason">{{quotationSelectionReason}}</view>
        </view>
        <view wx:if="{{quotationSelectionRequired}}" class="order-selection-required">必须选择</view>
      </view>
      <view wx:for="{{quotationCandidates}}" wx:key="id" class="order-candidate {{item.id === selectedQuotationId ? 'order-candidate-selected' : ''}}">
        <view class="order-candidate-title">{{item.customerDisplayName}} · {{item.productSummary || '未填产品'}}</view>
        <view class="order-candidate-meta">
          {{item.itemCount}}项 · {{item.status || '-'}} · 报价日期{{item.quoteDate || '-'}}
        </view>
        <view wx:if="{{item.quotationAmount}}" class="order-candidate-meta">报价金额：{{item.quotationAmount}}元</view>
      </view>
      <view wx:if="{{showGenericQuotationPicker}}" class="field match-picker-field">
        <text class="label">原话指的是哪张报价</text>
        <picker mode="selector" range="{{quotationRange}}" value="{{selectedQuotationIndex}}" bindchange="changeQuotation">
          <view class="input date-picker-input">
            <text wx:if="{{selectedQuotationIndex >= 0}}">{{selectedQuotationLabel}}</text>
            <text wx:else class="placeholder-text">请选择报价</text>
            <text class="picker-arrow">选择</text>
          </view>
        </picker>
      </view>
      <button wx:if="{{selectedQuotationId}}" class="secondary-button order-selection-clear" bindtap="clearQuotationSelection">取消关联</button>
    </view>
    <view wx:if="{{showProductSuggestion}}" class="confirm-warning" data-value="{{productSuggestionValue}}" bindtap="applyProductSuggestion">{{productSuggestionText}} 点这里采用建议</view>
    <view wx:if="{{showItemList}}" class="item-list-field">
      <view class="label">商品明细</view>
      <view wx:for="{{confirmItems}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="itemKey" class="confirm-item-card" data-item-key="{{item.itemKey}}">
        <view class="confirm-item-head">
          <text>{{item.indexLabel}}</text>
          <text wx:if="{{item.canRemove}}" class="confirm-item-remove" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" bindtap="removeConfirmItem">删除此项</text>
        </view>
        <view class="field item-field {{item.riskByField.productName ? 'surface-field-error' : ''}}">
          <text class="label">商品</text>
          <input class="input {{item.riskByField.productName ? 'surface-input-error' : ''}}" value="{{item.productName}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="productName" bindinput="updateItemField" placeholder="例如：保温杯" />
          <view wx:if="{{item.riskByField.productName}}" class="surface-field-risk">{{item.riskByField.productName.message}}</view>
          <view wx:if="{{item.showProductCatalogSuggestions}}" class="catalog-suggestion-box">
            <view class="catalog-suggestion-label">商品库里的常用商品</view>
            <view class="catalog-chip-row">
              <text wx:for="{{item.productSuggestions}}" wx:for-item="suggestion" wx:key="*this" class="catalog-chip" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-value="{{suggestion}}" bindtap="applyCatalogProduct">{{suggestion}}</text>
            </view>
          </view>
        </view>
        <view class="field item-field {{item.riskByField.spec ? 'surface-field-error' : ''}}">
          <text class="label">规格</text>
          <input class="input {{item.riskByField.spec ? 'surface-input-error' : ''}}" value="{{item.spec}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="spec" bindinput="updateItemField" placeholder="例如：紫色、红色、大号" />
          <view wx:if="{{item.riskByField.spec}}" class="surface-field-risk">{{item.riskByField.spec.message}}</view>
          <view wx:if="{{item.showSpecCatalogSuggestions}}" class="catalog-suggestion-box">
            <view class="catalog-suggestion-label">这个商品的常用规格</view>
            <view class="catalog-chip-row">
              <text wx:for="{{item.specSuggestions}}" wx:for-item="suggestion" wx:key="*this" class="catalog-chip" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-value="{{suggestion}}" bindtap="applyCatalogSpec">{{suggestion}}</text>
            </view>
          </view>
        </view>
        <view class="catalog-check-hint {{item.catalogHintClass}}">{{item.catalogHint}}</view>
        <view class="grid-2">
          <view class="field item-field {{item.riskByField.quantity ? 'surface-field-error' : ''}}">
            <text class="label">数量</text>
            <input class="input {{item.riskByField.quantity ? 'surface-input-error' : ''}}" value="{{item.quantity}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="quantity" bindinput="updateItemField" type="digit" />
            <view wx:if="{{item.riskByField.quantity}}" class="surface-field-risk">{{item.riskByField.quantity.message}}</view>
          </view>
          <view class="field item-field {{item.riskByField.unit ? 'surface-field-error' : ''}}">
            <text class="label">单位</text>
            <input class="input {{item.riskByField.unit ? 'surface-input-error' : ''}}" value="{{item.unit}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="unit" bindinput="updateItemField" />
            <view wx:if="{{item.riskByField.unit}}" class="surface-field-risk">{{item.riskByField.unit.message}}</view>
          </view>
        </view>
        <view class="grid-2">
          <view class="field item-field {{item.riskByField.unitPrice ? 'surface-field-error' : ''}}">
            <text class="label">单价</text>
            <input class="input {{item.riskByField.unitPrice ? 'surface-input-error' : ''}}" value="{{item.unitPrice}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="unitPrice" bindinput="updateItemField" type="digit" />
            <view wx:if="{{item.riskByField.unitPrice}}" class="surface-field-risk">{{item.riskByField.unitPrice.message}}</view>
          </view>
          <view class="field item-field {{item.riskByField.priceUnit ? 'surface-field-error' : ''}}">
            <text class="label">计价单位</text>
            <input class="input {{item.riskByField.priceUnit ? 'surface-input-error' : ''}}" value="{{item.priceUnit}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="priceUnit" bindinput="updateItemField" placeholder="通常同数量单位" />
            <view wx:if="{{item.riskByField.priceUnit}}" class="surface-field-risk">{{item.riskByField.priceUnit.message}}</view>
          </view>
        </view>
        <view class="field item-field {{item.riskByField.totalAmount ? 'surface-field-error' : ''}}">
          <text class="label">该项金额</text>
          <input class="input {{item.riskByField.totalAmount ? 'surface-input-error' : ''}}" value="{{item.totalAmount}}" data-index="{{itemIndex}}" data-item-key="{{item.itemKey}}" data-field="totalAmount" bindinput="updateItemField" type="digit" placeholder="单位不同时请手动确认" />
          <view wx:if="{{item.riskByField.totalAmount}}" class="surface-field-risk">{{item.riskByField.totalAmount.message}}</view>
        </view>
        <view wx:if="{{item.showItemDeliveryDate}}" class="item-meta-line">单项交期：{{item.itemDeliveryDate}}</view>
        <view wx:if="{{item.itemRemark}}" class="item-meta-line">备注：{{item.itemRemark}}</view>
      </view>
      <button class="confirm-item-add" bindtap="addConfirmItem">+ 添加规格或商品</button>
    </view>
    <view wx:if="{{showOrderAmountSummary}}" class="field order-amount-summary amount-field {{amountSurface.hasError ? 'surface-field-error' : ''}}" data-surface-role="amount-field">
      <text class="label">总金额</text>
      <input class="input amount-input {{amountSurface.hasError ? 'surface-input-error' : ''}}" value="{{fields.amount}}" data-field="amount" bindinput="updateField" type="digit" />
      <view wx:if="{{riskByField.amount}}" class="surface-field-risk">{{riskByField.amount.message}}</view>
      <view wx:if="{{amountSurface.canonicalTotalText}}" class="surface-amount-detail">{{amountSurface.canonicalTotalText}}</view>
      <view wx:for="{{orderAmountSupplementaryLines}}" wx:key="label" class="amount-summary-line">
        <text class="amount-summary-label">{{item.label}}</text>
        <text class="amount-summary-value">{{item.value}}</text>
      </view>
    </view>
    <view wx:if="{{showProductField}}" class="field surface-field {{riskByField.productName ? 'surface-field-error' : ''}}">
      <text class="label">产品/规格</text>
      <input class="input {{riskByField.productName ? 'surface-input-error' : ''}}" value="{{fields.productName}}" data-field="productName" bindinput="updateField" />
      <view wx:if="{{riskByField.productName}}" class="surface-field-risk">{{riskByField.productName.message}}</view>
    </view>
    <view wx:if="{{showQuantityFields}}" class="grid-2">
      <view class="field">
        <text class="label">数量</text>
        <input class="input" value="{{fields.quantity}}" data-field="quantity" bindinput="updateField" type="digit" />
      </view>
      <view class="field">
        <text class="label">单位</text>
        <input class="input" value="{{fields.unit}}" data-field="unit" bindinput="updateField" />
      </view>
    </view>
    <view wx:if="{{showPriceFields}}" class="grid-2">
      <view class="field">
        <text class="label">单价</text>
        <input class="input {{historyDefaultFieldMap.unitPrice ? 'history-default-input' : ''}}" value="{{fields.unitPrice}}" data-field="unitPrice" bindinput="updateField" type="digit" />
      </view>
      <view class="field {{riskByField.amount ? 'surface-field-error' : ''}}">
        <text class="label">{{amountLabel}}</text>
        <input class="input {{riskByField.amount ? 'surface-input-error' : ''}}" value="{{fields.amount}}" data-field="amount" bindinput="updateField" type="digit" />
        <view wx:if="{{riskByField.amount}}" class="surface-field-risk">{{riskByField.amount.message}}</view>
        <view wx:if="{{amountSurface.canonicalTotalText}}" class="surface-amount-detail">{{amountSurface.canonicalTotalText}}</view>
      </view>
    </view>
    <view wx:if="{{showAmountField && !showPriceFields}}" class="field {{riskByField.amount ? 'surface-field-error' : ''}}">
      <text class="label">{{amountLabel}}</text>
      <input class="input {{riskByField.amount ? 'surface-input-error' : ''}}" value="{{fields.amount}}" data-field="amount" bindinput="updateField" type="digit" />
      <view wx:if="{{riskByField.amount}}" class="surface-field-risk">{{riskByField.amount.message}}</view>
      <view wx:if="{{amountSurface.canonicalTotalText}}" class="surface-amount-detail">{{amountSurface.canonicalTotalText}}</view>
    </view>
    <view wx:if="{{showPaymentAmountField}}" class="field">
      <text class="label">{{paymentAmountLabel}}</text>
      <input class="input" value="{{fields.paymentAmount}}" data-field="paymentAmount" bindinput="updateField" type="digit" />
    </view>
    <view wx:if="{{showRemainingAmountField}}" class="field">
      <text class="label">剩余金额</text>
      <input class="input" value="{{fields.remainingAmount}}" data-field="remainingAmount" bindinput="updateField" type="digit" />
    </view>
    <view wx:if="{{showComputedTips}}" class="computed-box">
      <view wx:for="{{computedTips}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:if="{{showFollowupDaysField}}" class="field followup-card">
      <view class="followup-card-head">
        <view>
          <view class="followup-title">跟进日期</view>
          <view class="followup-subtitle">报价后提醒客户确认</view>
        </view>
        <view class="followup-default-pill">可不填</view>
      </view>
      <picker mode="selector" range="{{followupDayRange}}" value="{{selectedFollowupDayIndex}}" bindchange="changeFollowupDays">
        <view class="followup-picker">
          <text wx:if="{{fields.followupDays}}">报价后 {{fields.followupDays}} 天</text>
          <text wx:else>选择跟进天数</text>
          <text class="picker-arrow">选择</text>
        </view>
      </picker>
      <view class="followup-warning">{{followupWarningText}}</view>
    </view>
    <view wx:if="{{showDueDateField}}" class="field surface-field {{riskByField.dueDate ? 'surface-field-error' : ''}}">
      <text class="label">{{dueDateLabel}}</text>
      <picker mode="date" value="{{fields.dueDate}}" start="2020-01-01" end="2035-12-31" data-field="dueDate" bindchange="changeDateField">
        <view class="input date-picker-input {{historyDefaultFieldMap.dueDate ? 'history-default-input' : ''}} {{riskByField.dueDate ? 'surface-input-error' : ''}}">
          <text wx:if="{{fields.dueDate}}">{{fields.dueDate}}</text>
          <text wx:else class="placeholder-text">点击选择日期</text>
          <text class="picker-arrow">选择</text>
        </view>
      </picker>
      <view wx:if="{{riskByField.dueDate}}" class="surface-field-risk">{{riskByField.dueDate.message}}</view>
    </view>

    <view wx:if="{{showPaymentConfirm}}" class="payment-confirm-box">
      <view wx:if="{{showReceivablePicker}}" class="field">
        <text class="label">选择本次收哪一笔</text>
        <picker mode="selector" range="{{receivableRange}}" value="{{selectedReceivableIndex}}" bindchange="changeReceivable">
          <view class="input">{{selectedReceivableLabel || '请选择待收款 / 欠款'}}</view>
        </picker>
      </view>
      <view wx:if="{{paymentPreview.length}}" class="payment-preview">
        <view wx:for="{{paymentPreview}}" wx:key="*this" class="preview-line">{{item}}</view>
      </view>
      <view wx:if="{{paymentWarningText}}" class="payment-warning">{{paymentWarningText}}</view>
    </view>

    <view wx:if="{{showNewReceivableWithPayment}}" class="payment-confirm-box">
      <view wx:if="{{newReceivablePreview.length}}" class="payment-preview">
        <view wx:for="{{newReceivablePreview}}" wx:key="*this" class="preview-line">{{item}}</view>
      </view>
      <view wx:if="{{newReceivableWarningText}}" class="payment-warning">{{newReceivableWarningText}}</view>
    </view>

    <view wx:if="{{showOrderDepositConfirm}}" class="payment-confirm-box">
      <view wx:if="{{showOrderPicker}}" class="field">
        <text class="label">选择定金属于哪一单</text>
        <picker mode="selector" range="{{orderRange}}" value="{{selectedOrderIndex}}" bindchange="changeOrderDeposit">
          <view class="input">{{selectedOrderLabel || '请选择订单'}}</view>
        </picker>
      </view>
      <view wx:if="{{orderDepositPreview.length}}" class="payment-preview">
        <view wx:for="{{orderDepositPreview}}" wx:key="*this" class="preview-line">{{item}}</view>
      </view>
      <view wx:if="{{orderDepositWarningText}}" class="payment-warning">{{orderDepositWarningText}}</view>
    </view>

    <view wx:if="{{showHistoryWarning}}" class="surface-note-box">
      <view class="surface-note-title">和之前记录有关</view>
      <view class="surface-note-text">{{historyWarningText}}</view>
    </view>
    <view wx:if="{{showHistoryDefaultWarning}}" class="surface-note-box surface-note-warning">
      <view class="surface-note-title">这项沿用了上次记录</view>
      <view class="surface-note-text">{{historyDefaultWarningText}}</view>
    </view>
    <view wx:if="{{showSupersededFacts}}" class="surface-note-box">
      <view class="surface-note-title">原话中已被后续内容更新</view>
      <view wx:for="{{supersededFactLines}}" wx:key="*this" class="surface-note-text">{{item}}</view>
    </view>
    <view wx:if="{{showRemarkItems}}" class="surface-note-box">
      <view class="surface-note-title">客户特殊要求</view>
      <view wx:for="{{remarkItemLines}}" wx:key="*this" class="surface-note-text">{{item}}</view>
    </view>

    <view wx:if="{{showRemarkField}}" class="field">
      <text class="label">备注</text>
      <textarea class="textarea small-textarea" value="{{fields.remark}}" maxlength="-1" data-field="remark" bindinput="updateField" />
    </view>

    <view wx:if="{{showSurfaceGlobalRisk}}" class="surface-global-risk">
      {{surfaceGlobalRiskText}}
    </view>
    <view wx:if="{{isNoRecord}}" class="warning-box">
      <view class="card-title">无需记录</view>
      <view class="muted">{{noRecordMessage}}</view>
    </view>

    <view wx:if="{{surfaceOriginalText}}" class="original-text-surface">
      <button class="original-text-toggle" bindtap="toggleOriginalText">
        {{originalTextExpanded ? '收起原话 ∧' : '查看原话 >'}}
      </button>
      <view wx:if="{{originalTextExpanded}}" class="original-text-content">{{surfaceOriginalText}}</view>
    </view>
    </scroll-view>

    <view class="button-row confirm-action-row">
      <button class="secondary-button" bindtap="returnToInput">重新输入原话</button>
      <button wx:if="{{showPendingButton}}" hidden="{{activeQuestion || assistantQuestionState === 'SAFE_BLOCKED'}}" class="secondary-button" bindtap="savePending">先放待整理</button>
      <button wx:if="{{showFormalSaveButton}}" hidden="{{activeQuestion}}" class="primary-button formal-save-button" disabled="{{disableFormalSave}}" bindtap="saveFormal">{{formalButtonText}}</button>
    </view>
  </view>
  </view>
</view>
