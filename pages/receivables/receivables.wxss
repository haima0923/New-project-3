.amount-row {
  display: grid;
  gap: 20rpx;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 16rpx;
}

.money {
  color: #101828;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.4;
}

.detail-line {
  color: #344054;
  font-size: 28rpx;
  line-height: 1.7;
}

.overdue {
  background: #fff1f3;
  border-radius: 12rpx;
  color: #c01048;
  font-size: 26rpx;
  margin: 14rpx 0;
  padding: 14rpx;
}

.payment-field {
  margin-top: 18rpx;
}

.empty-button {
  margin-top: 28rpx;
  width: 100%;
}
