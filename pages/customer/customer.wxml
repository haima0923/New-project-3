<view class="page">
  <block wx:if="{{!id}}">
    <view class="page-title">客户档案</view>
    <view class="page-subtitle">客户帮你把报价、订单和收款串起来，刚开始只记称呼就行。</view>
    <view wx:if="{{!customers.length}}" class="empty">
      <view class="card-title">还没有客户</view>
      <view class="muted">第一笔报价、订单或待收款保存后，会自动生成客户档案。</view>
    </view>
    <view wx:for="{{customers}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openCustomer">
      <view class="row-between">
        <view class="card-title">{{item.display}}</view>
        <view wx:if="{{item.duplicateSuspect}}" class="pill pill-warning">疑似重复</view>
      </view>
      <view class="muted">{{item.isTemporary ? '还没补手机号也没关系' : '已记录联系方式'}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="page-title">{{customer.name || '客户详情'}}</view>
    <view class="page-subtitle">{{customer.company || customer.region || '还没补客户资料'}}</view>

    <view class="card">
      <view class="card-title">快捷操作</view>
      <view class="button-row">
        <button class="primary-button" bindtap="goInput">记一笔</button>
      </view>
    </view>

    <view wx:if="{{duplicateCandidates.length}}" class="card">
      <view class="card-title">疑似重复客户</view>
      <view class="muted">如果是同一个人，合并后报价、订单和待收都会归到这里。</view>
      <view wx:for="{{duplicateCandidates}}" wx:key="id" class="duplicate-item">
        <view class="duplicate-title">{{item.display}}</view>
        <view class="button-row">
          <button class="primary-button" data-id="{{item.id}}" catchtap="mergeDuplicate">合并到当前客户</button>
          <button class="secondary-button" data-id="{{item.id}}" catchtap="keepSeparate">保留为不同客户</button>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">报价历史 {{quotations.length}}</view>
      <view wx:for="{{quotations}}" wx:key="id" class="list-item">
        <view>{{item.itemsSummary || item.productName || '未填产品'}} {{item.totalAmount || '-'}} 元</view>
        <view class="muted">{{item.quoteDate}} · {{item.status}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">订单历史 {{orders.length}}</view>
      <view wx:for="{{orders}}" wx:key="id" class="list-item">
        <view>{{item.itemsSummary || item.productName || '未填产品'}} · {{item.status}}</view>
        <view class="muted">交期 {{item.requiredDeliveryDate || '-'}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">收款记录 {{receivables.length}}</view>
      <view wx:for="{{receivables}}" wx:key="id" class="list-item">
        <view>{{item.amount || 0}} 元 · {{item.status}}</view>
        <view class="muted">到期 {{item.dueDate || '-'}}</view>
      </view>
    </view>
  </block>
</view>
