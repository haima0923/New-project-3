.detail-line {
  color: #3B4E5B;
  font-size: 28rpx;
  line-height: 1.7;
}

.item-lines {
  background: #F5F7F8;
  border-radius: 14rpx;
  margin-bottom: 8rpx;
  padding: 10rpx 14rpx;
}

.item-detail-line {
  font-size: 26rpx;
}

.followup-box {
  background: #fff7e6;
  border-radius: 12rpx;
  color: #b54708;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 16rpx;
  padding: 18rpx;
}

.empty-button {
  margin-top: 28rpx;
  width: 100%;
}

.converted-button[disabled] {
  background: #f2f4f7;
  color: #667085;
}

.converted-line {
  color: #667085;
  font-size: 26rpx;
}

.convert-order-panel {
  background: #F5F7F8;
  border-radius: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
}

.convert-order-title {
  color: #344054;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.conversion-date-options {
  margin: 0 -18rpx;
  white-space: nowrap;
  width: auto;
}

.conversion-date-option-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 18rpx 8rpx;
}

.conversion-date-option {
  background: #FFFFFF;
  border: 1rpx solid #D0D5DD;
  border-radius: 14rpx;
  color: #475467;
  min-width: 120rpx;
  padding: 14rpx 12rpx;
  text-align: center;
}

.conversion-date-option-active {
  background: #EAF2FF;
  border-color: #1677FF;
  color: #0F5DB8;
}

.conversion-date-weekday {
  font-size: 22rpx;
  line-height: 1.4;
}

.conversion-date-day {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.conversion-date-selected {
  color: #344054;
  font-size: 25rpx;
  margin-top: 10rpx;
}
