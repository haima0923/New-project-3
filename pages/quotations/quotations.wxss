.detail-line {
  color: #344054;
  font-size: 28rpx;
  line-height: 1.7;
}

.item-lines {
  background: #F8FAFC;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  padding: 10rpx 14rpx;
}

.item-detail-line {
  font-size: 26rpx;
}

.followup-box {
  background: #fff7e6;
  border-radius: 12rpx;
  color: #b54708;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 16rpx;
  padding: 18rpx;
}

.empty-button {
  margin-top: 28rpx;
  width: 100%;
}

.converted-button[disabled] {
  background: #f2f4f7;
  color: #667085;
}

.converted-line {
  color: #667085;
  font-size: 26rpx;
}
