page {
  background: #F6F7FB;
  color: #1F2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.page-title {
  color: #0F172A;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.25;
  margin-bottom: 12rpx;
}

.page-subtitle {
  color: #6B7280;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #E5E7EB;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.card-title {
  color: #1F2937;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  margin-bottom: 8rpx;
}

.muted {
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.5;
}

.row {
  align-items: center;
  display: flex;
}

.row-between {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.grid-2 {
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr 1fr;
}

.primary-button,
.secondary-button,
.danger-button {
  border: 0;
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 1.2;
  margin: 0;
  min-height: 88rpx;
  padding: 24rpx;
}

.primary-button {
  background: #1677FF;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #D1D5DB;
  color: #6B7280;
}

.secondary-button {
  background: #EAF2FF;
  color: #1677FF;
}

.danger-button {
  background: #fff1f3;
  color: #c01048;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.button-row button {
  flex: 1;
}

.pill {
  background: #EAF2FF;
  border-radius: 999rpx;
  color: #1677FF;
  display: inline-flex;
  font-size: 24rpx;
  line-height: 1;
  padding: 12rpx 18rpx;
}

.pill-warning {
  background: #fff7e6;
  color: #b54708;
}

.pill-danger {
  background: #fff1f3;
  color: #c01048;
}

.field {
  margin-bottom: 18rpx;
}

.compact-filter-bar {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #E5E7EB;
  border-radius: 28rpx;
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 12rpx;
}

.compact-search-input {
  background: #F6F7FB;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  color: #1F2937;
  flex: 1;
  font-size: 28rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
}

.compact-filter-button {
  background: #EAF2FF;
  border: 0;
  border-radius: 20rpx;
  color: #1677FF;
  flex: 0 0 128rpx;
  font-size: 28rpx;
  line-height: 1;
  margin: 0;
  min-height: 72rpx;
  padding: 20rpx 0;
}

.compact-filter-button-active {
  background: #1677FF;
  color: #ffffff;
}

.compact-filter-summary {
  align-items: center;
  color: #6B7280;
  display: flex;
  font-size: 24rpx;
  justify-content: space-between;
  margin: -6rpx 4rpx 16rpx;
}

.compact-clear-text {
  color: #1677FF;
  padding-left: 24rpx;
}

.filter-card,
.filter-panel {
  background: #ffffff;
  border: 1rpx solid #E5E7EB;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.filter-panel {
  margin-top: -4rpx;
}

.filter-panel-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.filter-panel-title {
  color: #1F2937;
  font-size: 30rpx;
  font-weight: 700;
}

.filter-panel-close {
  background: #f2f4f7;
  border: 0;
  border-radius: 999rpx;
  color: #344054;
  font-size: 24rpx;
  line-height: 1;
  margin: 0;
  min-height: 56rpx;
  padding: 16rpx 22rpx;
}

.filter-grid {
  display: grid;
  gap: 0 16rpx;
  grid-template-columns: 1fr 1fr;
}

.filter-date-input {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #D1D5DB;
  border-radius: 22rpx;
  color: #1F2937;
  display: flex;
  font-size: 30rpx;
  min-height: 84rpx;
  padding: 20rpx;
  width: 100%;
}

.filter-placeholder {
  color: #98a2b3;
}

.filter-footer {
  align-items: center;
  border-top: 1rpx solid #eaecf0;
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
}

.filter-reset-button {
  background: #EAF2FF;
  border: 0;
  border-radius: 20rpx;
  color: #1677FF;
  font-size: 26rpx;
  line-height: 1;
  margin: 0;
  min-height: 64rpx;
  padding: 18rpx 24rpx;
}

.filter-reset-button[disabled] {
  background: #f2f4f7;
  color: #98a2b3;
}

.label {
  color: #344054;
  display: block;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.input,
.textarea {
  background: #ffffff;
  border: 1rpx solid #D1D5DB;
  border-radius: 22rpx;
  color: #1F2937;
  font-size: 30rpx;
  min-height: 84rpx;
  padding: 20rpx;
  width: 100%;
}

.textarea {
  line-height: 1.5;
  min-height: 220rpx;
}

.empty {
  align-items: center;
  background: #ffffff;
  border: 1rpx dashed #BBD6FF;
  border-radius: 32rpx;
  color: #4B5563;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 300rpx;
  padding: 36rpx;
  text-align: center;
}

.stat-number {
  color: #1677FF;
  display: block;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 10rpx;
}

.divider {
  background: #eaecf0;
  height: 1rpx;
  margin: 20rpx 0;
}

.list-item {
  border-bottom: 1rpx solid #eaecf0;
  padding: 20rpx 0;
}

.list-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.small-action {
  color: #1677FF;
  font-size: 26rpx;
  padding: 0;
}

.empty-button {
  margin-top: 28rpx;
  width: 100%;
}
