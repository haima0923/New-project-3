.tab-voice-overlay {
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.5);
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  padding: 0 36rpx calc(238rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1380;
}

.tab-voice-panel {
  background: rgba(15, 23, 42, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.24);
  color: #FFFFFF;
  min-width: 380rpx;
  padding: 28rpx 36rpx;
  text-align: center;
}

.tab-voice-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tab-voice-subtitle,
.tab-voice-cancel-hint {
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.4;
  margin-top: 10rpx;
}

.tab-voice-gesture-cancel .tab-voice-panel {
  background: rgba(180, 35, 24, 0.92);
}

.tab-voice-ready .tab-voice-panel {
  background: rgba(8, 78, 175, 0.95);
  box-shadow: 0 20rpx 50rpx rgba(9, 92, 206, 0.38);
}

.tab-voice-ready .tab-voice-title {
  font-size: 38rpx;
  font-weight: 900;
}

.tab-voice-ready .tab-voice-subtitle {
  color: rgba(255, 255, 255, 0.96);
  font-size: 25rpx;
  font-weight: 800;
}

.tab-voice-gesture-cancel .tab-voice-cancel-hint {
  color: #FFFFFF;
  font-weight: 800;
}

.tab-voice-readiness-shell {
  align-items: center;
  background: rgba(22, 119, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 999rpx;
  display: flex;
  height: 112rpx;
  justify-content: center;
  margin: 26rpx auto 0;
  overflow: hidden;
  position: relative;
  width: 112rpx;
}

.voice-readiness-fill {
  background: linear-gradient(180deg, rgba(123, 196, 255, 0.72) 0%, rgba(22, 119, 255, 0.96) 100%);
  bottom: 0;
  left: 0;
  pointer-events: none;
  position: absolute;
  right: 0;
  top: 0;
  transform: translateY(100%);
  z-index: 1;
}

.voice-readiness-fill-filling {
  animation: tabVoiceReadinessFillUp 700ms linear forwards;
}

.voice-readiness-fill-full {
  transform: translateY(0);
}

@keyframes tabVoiceReadinessFillUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.tab-readiness-mic {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.tab-readiness-mic-body {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 48rpx;
  width: 28rpx;
}

.tab-readiness-mic-stem {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 14rpx;
  margin-top: 2rpx;
  width: 6rpx;
}

.tab-readiness-mic-base {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 5rpx;
  margin-top: -1rpx;
  width: 31rpx;
}

.tab-shell {
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #E1E8EC;
  bottom: 0;
  box-shadow: 0 -8rpx 24rpx rgba(20, 47, 65, 0.06);
  left: 0;
  position: fixed;
  right: 0;
  z-index: 900;
}

.tab-safe {
  align-items: center;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  min-height: 116rpx;
  padding: 10rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
}

.tab-item {
  align-items: center;
  color: #6B7280;
  display: flex;
  flex-direction: column;
  font-size: 21rpx;
  font-weight: 600;
  justify-content: center;
  line-height: 1.2;
  min-height: 84rpx;
  opacity: 0.9;
  position: relative;
}

.tab-icon {
  align-items: center;
  border-radius: 16rpx;
  color: #687782;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  height: 40rpx;
  justify-content: center;
  margin-bottom: 5rpx;
  width: 40rpx;
}

.center-icon {
  align-items: center;
  background:
    radial-gradient(circle at 32% 22%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.50) 13%, rgba(255, 255, 255, 0) 24%),
    radial-gradient(circle at 34% 30%, #B8DCFF 0%, #5FA4FF 34%, #1677FF 72%, #0B5ED7 100%);
  border: 10rpx solid #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 34rpx rgba(22, 119, 255, 0.38), 0 0 0 9rpx rgba(22, 119, 255, 0.10);
  display: flex;
  height: 136rpx;
  justify-content: center;
  margin-bottom: 0;
  margin-top: -76rpx;
  width: 136rpx;
  z-index: 2;
}

.tab-mic-symbol {
  align-items: center;
  display: flex;
  flex-direction: column;
  height: 74rpx;
  justify-content: center;
  width: 60rpx;
}

.tab-mic-body {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 48rpx;
  width: 30rpx;
}

.tab-mic-stem {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 14rpx;
  margin-top: 2rpx;
  width: 6rpx;
}

.tab-mic-base {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 5rpx;
  margin-top: -1rpx;
  width: 31rpx;
}

.tab-item-active {
  color: #1677FF;
  font-weight: 800;
  opacity: 1;
}

.tab-item-active .tab-icon {
  background: #EAF2FF;
  color: #1677FF;
}

.tab-item-center {
  opacity: 1;
}

.tab-item-center .tab-text {
  font-size: 0;
  height: 0;
  overflow: hidden;
}

.tab-text {
  white-space: nowrap;
}

.tab-badge {
  background: #FF4D4F;
  border: 2rpx solid #FFFFFF;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  min-width: 30rpx;
  padding: 5rpx 8rpx;
  position: absolute;
  right: 24rpx;
  top: 8rpx;
}
