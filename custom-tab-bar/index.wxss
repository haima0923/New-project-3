.tab-shell {
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #E5E7EB;
  bottom: 0;
  box-shadow: 0 -8rpx 26rpx rgba(31, 41, 55, 0.07);
  left: 0;
  position: fixed;
  right: 0;
  z-index: 900;
}

.tab-safe {
  align-items: center;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  min-height: 116rpx;
  padding: 10rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
}

.tab-item {
  align-items: center;
  color: #6B7280;
  display: flex;
  flex-direction: column;
  font-size: 21rpx;
  font-weight: 600;
  justify-content: center;
  line-height: 1.2;
  min-height: 84rpx;
  opacity: 0.9;
  position: relative;
}

.tab-icon {
  align-items: center;
  border-radius: 16rpx;
  color: #667085;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  height: 40rpx;
  justify-content: center;
  margin-bottom: 5rpx;
  width: 40rpx;
}

.center-icon {
  align-items: center;
  background:
    radial-gradient(circle at 32% 22%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.50) 13%, rgba(255, 255, 255, 0) 24%),
    radial-gradient(circle at 34% 30%, #B8DCFF 0%, #5FA4FF 34%, #1677FF 72%, #0B5ED7 100%);
  border: 10rpx solid #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 34rpx rgba(22, 119, 255, 0.42), 0 0 0 9rpx rgba(22, 119, 255, 0.11);
  display: flex;
  height: 136rpx;
  justify-content: center;
  margin-bottom: 0;
  margin-top: -76rpx;
  width: 136rpx;
  z-index: 2;
}

.tab-mic-symbol {
  align-items: center;
  display: flex;
  flex-direction: column;
  height: 74rpx;
  justify-content: center;
  width: 60rpx;
}

.tab-mic-body {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 48rpx;
  width: 30rpx;
}

.tab-mic-stem {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 14rpx;
  margin-top: 2rpx;
  width: 6rpx;
}

.tab-mic-base {
  background: #FFFFFF;
  border-radius: 999rpx;
  height: 5rpx;
  margin-top: -1rpx;
  width: 31rpx;
}

.tab-item-active {
  color: #1677FF;
  font-weight: 800;
  opacity: 1;
}

.tab-item-active .tab-icon {
  background: #EAF2FF;
  color: #1677FF;
}

.tab-item-center {
  opacity: 1;
}

.tab-item-center .tab-text {
  font-size: 0;
  height: 0;
  overflow: hidden;
}

.tab-text {
  white-space: nowrap;
}

.tab-badge {
  background: #FF4D4F;
  border: 2rpx solid #FFFFFF;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  min-width: 30rpx;
  padding: 5rpx 8rpx;
  position: absolute;
  right: 24rpx;
  top: 8rpx;
}
