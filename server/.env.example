PORT=3001
NODE_ENV=production

# Leave AI_API_KEY empty to use mock AI for deployment-chain testing.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Comma-separated Mini Program request origins are not required by wx.request,
# but this keeps browser debugging tidy. Use * only for a temporary test box.
ALLOWED_ORIGINS=*
