PORT=3001
NODE_ENV=production

# Leave AI_API_KEY empty to use mock AI for deployment-chain testing.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Comma-separated browser origins for debugging. wx.request does not need CORS.
# Leave empty in production unless you intentionally serve a browser client.
ALLOWED_ORIGINS=

# Per-client protection for public AI endpoints. A real release still needs
# WeChat login authentication before this server is exposed to all users.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=30

# 微信登录校验：正式环境默认必须开启。AppSecret 和令牌密钥只放服务器
# 环境变量，不得写入小程序代码、Git 仓库或聊天记录。
AUTH_REQUIRED=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 使用至少 32 个随机字符，例如用密码管理器生成；不要重复使用 AI 服务密钥。
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
