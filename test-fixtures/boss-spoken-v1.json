    "source": "voice",
    "input": "明朝提醒我回赵姐样品价格",
    "expect": { "intent": "todo", "customer": "赵姐" }
  },
  {
    "id": "typed-dunning",
    "group": "催款提醒",
    "source": "typed",
    "input": "下周一记得催王总尾款",
    "expect": { "intent": "dunning", "customer": "王总" }
  },
  {
    "id": "voice-todo-reordered",
    "group": "语序颠倒",
    "source": "voice",
